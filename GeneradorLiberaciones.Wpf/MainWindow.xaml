<Window x:Class="GeneradorLiberaciones.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Generador de Liberaciones"
        Height="550"
        Width="900"
        Loaded="Window_Loaded">

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Auto">

        <Grid Margin="10">
            <!-- FILAS PRINCIPALES -->
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- 0: Excel -->
                <RowDefinition Height="Auto"/>
                <!-- 1: Plantillas -->
                <RowDefinition Height="Auto"/>
                <!-- 2: Modo -->
                <RowDefinition Height="Auto"/>
                <!-- 3: Logs -->
                <RowDefinition Height="Auto"/>
                <!-- 4: Folios -->
                <RowDefinition Height="*"/>
                <!-- 5: Salida -->
                <RowDefinition Height="Auto"/>
                <!-- 6: Botón -->
            </Grid.RowDefinitions>

            <!-- 0) Archivo Excel -->
            <GroupBox Header="Archivo Excel" Grid.Row="0" Margin="0,0,0,10">
                <Grid Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="txtExcelPath"
                         Grid.Column="0"
                         IsReadOnly="True"
                         Margin="0,0,5,0"/>

                    <Button x:Name="btnSeleccionarExcel"
                        Grid.Column="1"
                        Content="Buscar..."
                        Width="100"
                        Click="btnSeleccionarExcel_Click"/>
                </Grid>
            </GroupBox>

            <!-- 1) Plantillas Word -->
            <GroupBox Header="Plantillas Word" Grid.Row="1" Margin="0,0,0,10">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- LIBERACIÓN -->
                    <TextBlock Grid.Row="0" Grid.Column="0"
                           Text="LIBERACIÓN:"
                           VerticalAlignment="Center"
                           Margin="0,0,5,0"/>
                    <TextBox x:Name="txtTemplateLib"
                         Grid.Row="0" Grid.Column="1"
                         Margin="0,0,5,0"
                         IsReadOnly="True"/>
                    <Button x:Name="btnSeleccionarTemplateLib"
                        Grid.Row="0" Grid.Column="2"
                        Content="Buscar..."
                        Width="100"
                        Click="btnSeleccionarTemplateLib_Click"/>

                    <!-- CALIFICACIONES -->
                    <TextBlock Grid.Row="1" Grid.Column="0"
                           Text="CALIFICACIONES:"
                           VerticalAlignment="Center"
                           Margin="0,5,5,0"/>
                    <TextBox x:Name="txtTemplateCal"
                         Grid.Row="1" Grid.Column="1"
                         Margin="0,5,5,0"
                         IsReadOnly="True"/>
                    <Button x:Name="btnSeleccionarTemplateCal"
                        Grid.Row="1" Grid.Column="2"
                        Content="Buscar..."
                        Width="100"
                        Margin="0,5,0,0"
                        Click="btnSeleccionarTemplateCal_Click"/>
                </Grid>
            </GroupBox>

            <!-- 2) Modo de generación -->
            <GroupBox Header="Modo de generación" Grid.Row="2" Margin="0,0,0,10">
                <StackPanel Orientation="Vertical" Margin="10">
                    <RadioButton x:Name="rbGenerarTodos"
                     Content="Generar TODOS los documentos"
                     IsChecked="True"
                     Margin="0,0,0,5"/>
                    <RadioButton x:Name="rbGenerarSoloNuevos"
                     Content="Generar SOLO nuevos (excluir NO_CONTROL ya generados)"
                     Margin="0,0,0,5"/>
                    <RadioButton x:Name="rbGenerarSoloListado"
                     Content="Generar SOLO los NO_CONTROL listados en logs (.txt)"/>
                </StackPanel>
            </GroupBox>


            <!-- 3) Logs de NO_CONTROL -->
            <GroupBox Header="Logs de NO_CONTROL ya generados o exclusivos a generar"
                  Grid.Row="3" Margin="0,0,0,10">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0"
                           Text="Puedes cargar uno o varios archivos .txt (se unirán todos los NO_CONTROL)."
                           Margin="0,0,0,5"/>

                    <ListBox x:Name="lstLogs"
                         Grid.Row="1" Grid.Column="0"
                         Height="100"/>

                    <StackPanel Grid.Row="1" Grid.Column="1"
                            Orientation="Vertical"
                            Margin="10,0,0,0">
                        <Button Content="Agregar logs..."
                            Width="120"
                            Margin="0,0,0,5"
                            Click="btnAgregarLogs_Click"/>
                        <Button Content="Quitar seleccionado"
                            Width="120"
                            Click="btnQuitarLog_Click"/>
                    </StackPanel>
                </Grid>
            </GroupBox>

            <!-- 4) Folios -->
            <GroupBox Header="Folios" Grid.Row="4" Margin="0,0,0,10">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <!-- Inputs -->
                        <RowDefinition Height="Auto"/>
                        <!-- Última ejecución -->
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="100"/>
                    </Grid.ColumnDefinitions>

                    <!-- FILA 0: folios iniciales -->
                    <TextBlock Grid.Row="0" Grid.Column="0"
                           Text="Folio inicial LIBERACIONES:"
                           VerticalAlignment="Center"/>
                    <TextBox x:Name="txtFolioLib"
                         Grid.Row="0" Grid.Column="1"
                         Margin="5,0,0,0"
                         HorizontalContentAlignment="Right"/>

                    <TextBlock Grid.Row="0" Grid.Column="3"
                           Text="Folio inicial CALIFICACIONES:"
                           VerticalAlignment="Center"/>
                    <TextBox x:Name="txtFolioCal"
                         Grid.Row="0" Grid.Column="4"
                         Margin="5,0,0,0"
                         HorizontalContentAlignment="Right"/>

                    <!-- FILA 1: última ejecución -->
                    <TextBlock Grid.Row="1" Grid.Column="0"
                           Text="Última ejecución:"
                           Margin="0,8,5,0"
                           VerticalAlignment="Center"/>
                    <TextBlock x:Name="txtUltimaEjecucion"
                           Grid.Row="1" Grid.Column="1"
                           Margin="0,8,0,0"
                           VerticalAlignment="Center"/>

                    <TextBlock Grid.Row="1" Grid.Column="3"
                           Text="Últimos folios (LIB / CAL):"
                           Margin="0,8,5,0"
                           VerticalAlignment="Center"/>
                    <StackPanel Grid.Row="1" Grid.Column="4"
                            Orientation="Horizontal"
                            Margin="0,8,0,0"
                            VerticalAlignment="Center">
                        <TextBlock x:Name="txtUltimoFolioLib"/>
                        <TextBlock Text=" / " Margin="2,0"/>
                        <TextBlock x:Name="txtUltimoFolioCal"/>
                    </StackPanel>
                </Grid>
            </GroupBox>

            <!-- 5) Salida -->
            <GroupBox Header="Salida" Grid.Row="5" Margin="0,0,0,10">
                <Grid Margin="10">
                    <TextBox x:Name="txtLog"
                         IsReadOnly="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto"
                         AcceptsReturn="True"/>
                </Grid>
            </GroupBox>

            <!-- 6) Botón generar -->
            <StackPanel Grid.Row="6"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
                <Button x:Name="btnGenerar"
                    Content="Generar documentos"
                    Width="180"
                    Height="35"
                    Click="btnGenerar_Click"/>
            </StackPanel>
        </Grid>

    </ScrollViewer>
</Window>
